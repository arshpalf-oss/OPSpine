# OPSpine — environment template
#
# OPTIONAL. OPSpine does not read .env files automatically; export these in
# your shell (or set them in a launcher / service unit) before starting.
#
# No key is required. The app runs fully offline with deterministic local tools.
# AI and research keys are normally entered in Settings, where they are stored
# in the local SQLite database and never sent back to the browser.

# ── Server ────────────────────────────────────────────
# Bind address. 127.0.0.1 = this machine only; 0.0.0.0 = reachable on your LAN.
OPSPINE_HOST=127.0.0.1
OPSPINE_PORT=5000
# OPSPINE_DEBUG=1
# OPSPINE_DATA_DIR=./data

# ── Optional: session secret ──────────────────────────
# Generated randomly on each start when unset.
# OPSPINE_SECRET_KEY=
