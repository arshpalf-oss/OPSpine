# OPSpine — API key configuration template
# Copy this to .env and fill in keys (keys are stored in DB, not here)
# No keys are required — OPSpine runs fully offline with deterministic engines.

# ── LLM providers ──────────────────────────────────────
# Google Gemini (reasoning, multimodal, fast)
GEMINI_API_KEY=

# Groq (fast inference, Whisper STT)
GROQ_API_KEY=

# OpenRouter (multi-model router: Qwen, Nemotron, etc.)
OPENROUTER_API_KEY=

# Cerebras (high-speed inference, optional)
CEREBRAS_API_KEY=

# ── Search providers ──────────────────────────────────
# Brave Search API — primary web search
BRAVE_SEARCH_KEY=

# Tavily — agent-optimized search
TAVILY_KEY=

# Exa — semantic / deep research search
EXA_KEY=

# ── Image generation (dedicated quota) ────────────────
IMAGE_API_KEY=
IMAGE_API_URL=

# ── Server config ─────────────────────────────────────
PORT=5000
